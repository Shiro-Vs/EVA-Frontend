# Solo valores PÚBLICOS. Todo EXPO_PUBLIC_* queda dentro del paquete de la app y es extraíble:
# nunca poner aquí claves de Gemini, claves de servicio ni contraseñas.

# API de EVA. En producción: https://api.eva-app.lat/v1
# Con tu API local: la IP de tu PC en la red WiFi y el puerto del backend (http://192.168.1.X:3000/v1)
EXPO_PUBLIC_API_URL=https://api.eva-app.lat/v1

# Supabase: URL del proyecto y clave «publishable» (PÚBLICA por diseño; nunca la clave secreta).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ID de cliente web de Google (público). Solo lo usa el APK para abrir la hoja de cuentas; sin él se usa el navegador.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
