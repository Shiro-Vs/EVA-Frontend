# Solo valores PÚBLICOS. Todo EXPO_PUBLIC_* queda dentro del paquete de la app y es extraíble:
# nunca poner aquí claves de Gemini, claves de servicio ni contraseñas.

# API de EVA (en local: IP de tu PC en la red WiFi, puerto del backend)
EXPO_PUBLIC_API_URL=http://192.168.1.X:3000/v1

# Desarrollo visual de pantallas sin backend (true/false)
EXPO_PUBLIC_USE_MOCKS=true

# Supabase Auth (clave "anon" pública; se completa en la tarea 0.11)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
